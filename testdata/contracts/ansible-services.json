  "explicit-override-matrix": {
    "exec_start": [
      "/opt/openstack_instance_exporter/openstack_instance_exporter",
      "-behavior.sensitivity=2.25",
      "-behavior.ewma_fast_tau=1m",
      "-behavior.ewma_slow_tau=1h",
      "-behavior.ports_config=/etc/oie/ports.yml",
      "-behavior.rules_config=/etc/oie/rules.yml",
      "-tor.exit.enable",
      "-tor.exit.direction=any",
      "-tor.exit.url=https://example.invalid/tor-exit.json",
      "-tor.exit.refresh=11m",
      "-tor.relay.enable",
      "-tor.relay.direction=any",
      "-tor.relay.url=https://example.invalid/tor-relay.json",
      "-tor.relay.refresh=12m",
      "-spamhaus.enable",
      "-spamhaus.direction=any",
      "-spamhaus.url=https://example.invalid/drop.txt",
      "-spamhaus.ipv6.url=https://example.invalid/dropv6.txt",
      "-spamhaus.refresh=13m",
      "-emergingthreats.enable",
      "-emergingthreats.direction=any",
      "-emergingthreats.url=https://example.invalid/emerging.txt",
      "-emergingthreats.refresh=14m",
      "-customlist.enable",
      "-customlist.direction=any",
      "-customlist.path=/etc/oie/custom.txt",
      "-customlist.refresh=15m",
      "-contacts.direction=any",
      "-worker.count=4",
      "-libvirt.uri=qemu:///system",
      "-host.threats.enable",
      "-host.interfaces=bgp-nic,br-monitoring",
      "-host.ips.allow-private",
      "-conntrack.raw.rcvbuf_bytes=67108864",
      "-conntrack.raw.rcv_timeout=9s",
      "-conntrack.ipv4.enable=true",
      "-conntrack.ipv6.enable=false",
      "-web.listen-address=127.0.0.1:19120",
      "-web.telemetry-path=/oie-metrics",
      "-log.file.enable",
      "-log.file.path=/var/log/oie.log",
      "-log.level=debug",
      "-threat.log.min_interval=1m",
      "-collection.interval=30s"
    ],
    "unit": [
      "[Unit]",
      "Description=OpenStack Instance Exporter",
      "After=network.target",
      "[Service]",
      "Type=simple",
      "User=root",
      "Group=root",
      "ExecStart=/opt/openstack_instance_exporter/openstack_instance_exporter -behavior.sensitivity=2.25 -behavior.ewma_fast_tau=1m -behavior.ewma_slow_tau=1h -behavior.ports_config=/etc/oie/ports.yml -behavior.rules_config=/etc/oie/rules.yml -tor.exit.enable -tor.exit.direction=any -tor.exit.url=https://example.invalid/tor-exit.json -tor.exit.refresh=11m -tor.relay.enable -tor.relay.direction=any -tor.relay.url=https://example.invalid/tor-relay.json -tor.relay.refresh=12m -spamhaus.enable -spamhaus.direction=any -spamhaus.url=https://example.invalid/drop.txt -spamhaus.ipv6.url=https://example.invalid/dropv6.txt -spamhaus.refresh=13m -emergingthreats.enable -emergingthreats.direction=any -emergingthreats.url=https://example.invalid/emerging.txt -emergingthreats.refresh=14m -customlist.enable -customlist.direction=any -customlist.path=/etc/oie/custom.txt -customlist.refresh=15m -contacts.direction=any -worker.count=4 -libvirt.uri=qemu:///system -host.threats.enable -host.interfaces=bgp-nic,br-monitoring -host.ips.allow-private -conntrack.raw.rcvbuf_bytes=67108864 -conntrack.raw.rcv_timeout=9s -conntrack.ipv4.enable=true -conntrack.ipv6.enable=false -web.listen-address=127.0.0.1:19120 -web.telemetry-path=/oie-metrics -log.file.enable -log.file.path=/var/log/oie.log -log.level=debug -threat.log.min_interval=1m -collection.interval=30s",
      "Restart=always",
      "RestartSec=3s",
      "TimeoutStopSec=15s",
      "NoNewPrivileges=true",
      "PrivateTmp=true",
      "ProtectHome=true",
