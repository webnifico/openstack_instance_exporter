      "[Unit]",
      "Description=OpenStack Instance Exporter",
      "After=network.target",
      "[Service]",
      "Type=simple",
      "User=root",
      "Group=root",
      "ExecStart=/opt/openstack_instance_exporter/openstack_instance_exporter -behavior.sensitivity=1.5 -inbound.behavior.enable -outbound.behavior.enable -tor.exit.enable -tor.exit.direction=any -tor.relay.enable -tor.relay.direction=any -spamhaus.enable -spamhaus.direction=any -emergingthreats.enable -emergingthreats.direction=any -web.listen-address=192.0.2.50:9120 -log.file.path=/var/log/openstack_instance_exporter.log",
      "Restart=always",
      "RestartSec=3s",
      "TimeoutStopSec=15s",
      "NoNewPrivileges=true",
      "PrivateTmp=true",
